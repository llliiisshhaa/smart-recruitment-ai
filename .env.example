# ==============================================================================
# Smart Recruitment System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual environment settings.
# NEVER commit your real '.env' file or production secrets to version control.
# ==============================================================================

# PostgreSQL database connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_recruitment
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_recruitment_test

# Secret key used for cryptographic signing (JWT tokens, sessions)
# Generate a secure key in production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your_secret_key_here_change_in_production

# Google Gemini API key for AI-driven question generation and resume analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed frontend URL for Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:5173
